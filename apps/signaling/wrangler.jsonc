// Cloudflare deployment of the signaling server (ADR-007).
// Deploy: `bun run deploy:cloudflare` from apps/signaling (after `bunx wrangler login`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropbeam-signaling",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "SignalingHub" }]
  },
  // Free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingHub"] }],
  "vars": {
    "ROOM_CAPACITY": "2",
    "MAX_ROOMS": "10000",
    "MAX_CONNECTIONS": "20000",
    "MAX_CONNECTIONS_PER_IP": "64",
    // Comma-separated site origins allowed to connect; empty = any.
    "ALLOWED_ORIGINS": ""
  }
}
