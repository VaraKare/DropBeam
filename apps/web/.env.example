# Copy to apps/web/.env.local for local overrides, or set these in Vercel.
# All VITE_* values are baked in at build time.

# Required in production: your signaling server's WebSocket URL.
# (Leave unset in local dev — the Vite dev server proxies /ws to localhost:8787.)
VITE_SIGNALING_URL=wss://your-signaling-host.example.com/ws

# Optional TURN relay for strict NATs (comma-separated URLs).
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
